{
  "rules": {
    ".read": false,
    ".write": false,
    "arena": {
      "_t": {
        "$id": {
          ".write": "$id.matches(/^[a-z0-9]{10}$/)",
          ".validate": "!newData.exists() || newData.val() == now"
        }
      },
      "$room": {
        ".read": "$room.matches(/^[A-Z]{4}$/)",
        "p": {
          "$pid": {
            ".write": "$room.matches(/^[A-Z]{4}$/) && $pid.matches(/^[a-z0-9]{10}$/)",
            ".validate": "!newData.exists() || (newData.hasChildren(['n', 'j', 'x', 'y', 't']) && newData.child('t').val() == now)",
            "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "a": { ".validate": "newData.isString() && newData.val().length < 6000 && newData.val().beginsWith('data:image/')" },
            "j": { ".validate": "newData.isNumber()" },
            "t": { ".validate": true },
            "by": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "ph": { ".validate": "newData.isString() && newData.val().matches(/^[LCPE]$/)" },
            "sh": { ".validate": "newData.hasChildren() || newData.isString()" },
            "$num": { ".validate": "newData.isNumber() && newData.val() > -1000000 && newData.val() < 1000000" }
          }
        }
      }
    }
  }
}

rules_version = '2';
// Regole della CLASSIFICA MONDIALE di Stellar Frontier.
// Chiunque può leggere la classifica e aggiungere un punteggio,
// ma nessuno può modificare o cancellare i punteggi degli altri.
service cloud.firestore {
  match /databases/{database}/documents {
    match /classifica/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n', 's', 'd'])
        && request.resource.data.keys().hasAll(['n', 's', 'd'])
        // nome: da 1 a 10 caratteri, solo lettere, numeri e spazi
        && request.resource.data.n is string
        && request.resource.data.n.size() >= 1
        && request.resource.data.n.size() <= 10
        && request.resource.data.n.matches('^[\\p{L}\\p{N} ]+$')
        // punti: numero intero positivo, con un tetto contro i valori assurdi
        && request.resource.data.s is int
        && request.resource.data.s > 0
        && request.resource.data.s <= 50000000
        // data: AAAA-MM-GG
        && request.resource.data.d is string
        && request.resource.data.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update, delete: if false;
    }
    // tutto il resto del database è chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
// Regole della CLASSIFICA MONDIALE di Stellar Frontier.
// Chiunque può leggere la classifica e aggiungere un punteggio,
// ma nessuno può modificare o cancellare i punteggi degli altri:
// la propria riga della partita si aggiorna solo con la sua chiave segreta.
service cloud.firestore {
  match /databases/{database}/documents {
    match /classifica/{id} {
      allow read: if true;
      allow create: if valida(request.resource.data);
      // La riga della partita in corso si aggiorna a fine missione, ma solo da chi
      // conosce la chiave segreta della riga: k deve dare l'impronta h salvata,
      // e ogni aggiornamento porta una nuova impronta (la chiave vecchia non serve più).
      // Il nome resta lo stesso e i punti possono solo salire.
      allow update: if valida(request.resource.data)
        && ('h' in resource.data)
        && request.resource.data.n == resource.data.n
        && request.resource.data.s >= resource.data.s
        && request.resource.data.k is string
        && request.resource.data.k.size() <= 64
        && hashing.sha256(request.resource.data.k).toHexString().lower() == resource.data.h
        && request.resource.data.h != resource.data.h;
      allow delete: if false;
    }
    // CLASSIFICA ARENA (sfide online): una riga per pilota.
    // p (punti) = 100 per abbattimento (b) + 500 per vittoria (v) + 50 per sfida (m).
    // Si crea con al massimo 5 sfide; ogni aggiornamento aggiunge da 1 a 5 sfide,
    // con al massimo 15 abbattimenti e 1 vittoria per sfida, e solo con la chiave segreta della riga.
    match /arena/{id} {
      allow read: if true;
      allow create: if arenaValida(request.resource.data)
        && request.resource.data.m <= 5
        && request.resource.data.v <= request.resource.data.m
        && request.resource.data.b <= request.resource.data.m * 15;
      allow update: if arenaValida(request.resource.data)
        && request.resource.data.n == resource.data.n
        && request.resource.data.m > resource.data.m
        && request.resource.data.m - resource.data.m <= 5
        && request.resource.data.v >= resource.data.v
        && request.resource.data.v - resource.data.v <= request.resource.data.m - resource.data.m
        && request.resource.data.b >= resource.data.b
        && request.resource.data.b - resource.data.b <= (request.resource.data.m - resource.data.m) * 15
        && request.resource.data.k is string
        && request.resource.data.k.size() <= 64
        && hashing.sha256(request.resource.data.k).toHexString().lower() == resource.data.h
        && request.resource.data.h != resource.data.h;
      allow delete: if false;
    }
    function arenaValida(r) {
      return r.keys().hasOnly(['n', 'p', 'v', 'b', 'm', 'a', 'h', 'k'])
        && r.keys().hasAll(['n', 'p', 'v', 'b', 'm', 'h'])
        && r.n is string
        && r.n.size() >= 1
        && r.n.size() <= 20
        && r.n.matches('^[\\p{L}\\p{N} ]+$')
        && r.v is int && r.v >= 0
        && r.b is int && r.b >= 0
        && r.m is int && r.m >= 1 && r.m <= 100000
        && r.p is int && r.p == r.b * 100 + r.v * 500 + r.m * 50
        && r.h is string && r.h.matches('^[0-9a-f]{64}$')
        && (!('a' in r)
            || (r.a is string
                && r.a.size() <= 8000
                && r.a.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')));
    }
    function valida(r) {
      return r.keys().hasOnly(['n', 's', 'd', 'a', 'h', 'k'])
        && r.keys().hasAll(['n', 's', 'd'])
        // nome: da 1 a 20 caratteri, solo lettere, numeri e spazi
        && r.n is string
        && r.n.size() >= 1
        && r.n.size() <= 20
        && r.n.matches('^[\\p{L}\\p{N} ]+$')
        // punti: numero intero positivo, con un tetto contro i valori assurdi
        // (una partita completa vale circa 100-200 mila punti)
        && r.s is int
        && r.s > 0
        && r.s <= 3000000
        // data: AAAA-MM-GG, solo di oggi o dei giorni appena prima (per i punteggi inviati in ritardo)
        && r.d is string
        && r.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dataRecente(r.d)
        // foto del pilota (facoltativa): miniatura JPEG piccola
        && (!('a' in r)
            || (r.a is string
                && r.a.size() <= 8000
                && r.a.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')))
        // impronta della chiave segreta della partita (facoltativa)
        && (!('h' in r) || (r.h is string && r.h.matches('^[0-9a-f]{64}$')));
    }
    function dataRecente(d) {
      let t = timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
      return t <= request.time + duration.value(1, 'd')
        && t >= request.time - duration.value(4, 'd');
    }
    // tutto il resto del database è chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

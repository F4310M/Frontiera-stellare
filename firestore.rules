rules_version = '2';
// Regole delle CLASSIFICHE di Conex / Stellar Frontier (aggiornate 2026-11-11).
// - Legge chiunque; scrive solo chi è entrato con l'accesso anonimo del gioco (accesso.js).
// - Ogni nome di pilota appartiene a chi lo ha usato per primo (raccolta `nomi`): solo chi ha la
//   chiave segreta del nome (nel browser e nel backup .sfsave) può scrivere righe con quel nome.
// - Limiti di velocità con l'ora del server: i punti crescono al ritmo di una partita vera,
//   non tutti in un colpo. Nessuno può cancellare o modificare le righe degli altri.
service cloud.firestore {
  match /databases/{database}/documents {

    function utente() {
      return request.auth != null;
    }
    function nomeOk(n) {
      return n is string && n.size() >= 1 && n.size() <= 20 && n.matches('^[\\p{L}\\p{N} ]+$');
    }
    // il pilota che scrive possiede il nome?
    function nomeMio(n) {
      return exists(/databases/$(database)/documents/nomi/$(n.lower())/piloti/$(request.auth.uid));
    }
    function fotoOk(r) {
      return !('a' in r)
        || (r.a is string && r.a.size() <= 8000 && r.a.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$'));
    }
    function secondi(t) {
      return (request.time.toMillis() - t.toMillis()) / 1000;
    }

    // ---------------------------------------------------------------- NOMI
    // nomi/{nome in minuscolo} = { n: nome, h: impronta SHA-256 della chiave segreta, t }
    // nomi/{nome}/piloti/{uid} = { k: chiave segreta, t }: nessuno la può leggere; serve a dire
    // "questo utente ha la chiave del nome".
    match /nomi/{key} {
      allow read: if true;
      allow create: if utente()
        && request.resource.data.keys().hasOnly(['n', 'h', 't'])
        && nomeOk(request.resource.data.n)
        && key == request.resource.data.n.lower()
        && request.resource.data.h is string && request.resource.data.h.matches('^[0-9a-f]{64}$')
        && request.resource.data.t == request.time;
      allow update, delete: if false;

      match /piloti/{uid} {
        allow read: if false;
        allow create, update: if utente() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['k', 't'])
          && request.resource.data.k is string && request.resource.data.k.size() <= 64
          && request.resource.data.t == request.time
          && hashing.sha256(request.resource.data.k).toHexString().lower()
             == getAfter(/databases/$(database)/documents/nomi/$(key)).data.h;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------- CLASSIFICA MONDIALE
    // Una riga per partita: nasce alla prima missione (c = ora di creazione) e cresce missione dopo missione.
    // Tetti (una partita completa vale circa 100-200 mila punti):
    //   alla creazione al massimo 80.000 punti; ogni aggiornamento al massimo +120.000 e non prima di 15 secondi;
    //   in tutto mai più di 80.000 + 150 punti per ogni secondo passato dalla creazione.
    match /classifica/{id} {
      allow read: if true;
      allow create: if utente() && valida(request.resource.data)
        && request.resource.data.c == request.time
        && request.resource.data.s <= 80000
        && nomeMio(request.resource.data.n);
      allow update: if utente() && valida(request.resource.data)
        && ('c' in resource.data) && ('t' in resource.data)
        && request.resource.data.n == resource.data.n
        && request.resource.data.c == resource.data.c
        && request.time >= resource.data.t + duration.value(15, 's')
        && request.resource.data.s >= resource.data.s
        && request.resource.data.s - resource.data.s <= 120000
        && request.resource.data.s <= 80000 + secondi(resource.data.c) * 150
        && nomeMio(request.resource.data.n);
      allow delete: if false;
    }
    function valida(r) {
      return r.keys().hasOnly(['n', 's', 'd', 'a', 't', 'c'])
        && r.keys().hasAll(['n', 's', 'd', 't', 'c'])
        && nomeOk(r.n)
        && r.s is int && r.s > 0 && r.s <= 3000000
        // data: AAAA-MM-GG, solo di oggi o dei giorni appena prima (per i punteggi inviati in ritardo)
        && r.d is string && r.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && dataRecente(r.d)
        && r.t == request.time
        && r.c is timestamp
        && fotoOk(r);
    }
    function dataRecente(d) {
      let t = timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
      return t <= request.time + duration.value(1, 'd')
        && t >= request.time - duration.value(4, 'd');
    }

    // ---------------------------------------------------------------- CLASSIFICA ARENA (ONLINE SCORE)
    // Una riga per pilota, con id = nome in minuscolo. p = 100 per abbattimento (b) + 500 per vittoria (v) + 50 per sfida (m).
    // Si crea con al massimo 5 sfide (oppure portando i totali della vecchia riga del pilota, campo o);
    // ogni aggiornamento aggiunge da 1 a 5 sfide, con al massimo 15 abbattimenti e 1 vittoria per sfida,
    // e almeno 30 secondi per ogni sfida aggiunta.
    match /arena/{id} {
      allow read: if true;
      allow create: if utente() && arenaValida(request.resource.data)
        && id == request.resource.data.n.lower()
        && nomeMio(request.resource.data.n)
        && ((!('o' in request.resource.data)
             && request.resource.data.m <= 5
             && request.resource.data.v <= request.resource.data.m
             && request.resource.data.b <= request.resource.data.m * 15)
            || migra(request.resource.data));
      allow update: if utente() && (
        // riga nuova (con t): solo il proprietario del nome, al ritmo delle sfide vere
        (('t' in resource.data) && arenaValida(request.resource.data)
          && request.resource.data.n == resource.data.n
          && request.resource.data.get('o', '') == resource.data.get('o', '')
          && request.resource.data.m > resource.data.m
          && request.resource.data.m - resource.data.m <= 5
          && request.resource.data.v >= resource.data.v
          && request.resource.data.v - resource.data.v <= request.resource.data.m - resource.data.m
          && request.resource.data.b >= resource.data.b
          && request.resource.data.b - resource.data.b <= (request.resource.data.m - resource.data.m) * 15
          && request.time >= resource.data.t + duration.value(30 * (request.resource.data.m - resource.data.m), 's')
          && nomeMio(request.resource.data.n))
        ||
        // vecchia riga (con la chiave segreta h): si può solo chiudere, passando i totali alla riga nuova
        (!('t' in resource.data) && !('x' in resource.data) && ('h' in resource.data)
          && request.resource.data.keys().hasOnly(['n', 'p', 'x', 'k'])
          && request.resource.data.n == resource.data.n
          && request.resource.data.p == 0
          && request.resource.data.x == resource.data.n.lower()
          && request.resource.data.k is string && request.resource.data.k.size() <= 64
          && hashing.sha256(request.resource.data.k).toHexString().lower() == resource.data.h
          && existsAfter(/databases/$(database)/documents/arena/$(request.resource.data.x))
          && getAfter(/databases/$(database)/documents/arena/$(request.resource.data.x)).data.get('o', '') == id)
      );
      allow delete: if false;
    }
    function arenaValida(r) {
      return r.keys().hasOnly(['n', 'p', 'v', 'b', 'm', 'a', 't', 'o'])
        && r.keys().hasAll(['n', 'p', 'v', 'b', 'm', 't'])
        && nomeOk(r.n)
        && r.v is int && r.v >= 0
        && r.b is int && r.b >= 0
        && r.m is int && r.m >= 1 && r.m <= 100000
        && r.p is int && r.p == r.b * 100 + r.v * 500 + r.m * 50
        && r.t == request.time
        && (!('o' in r) || (r.o is string && r.o.size() >= 1 && r.o.size() <= 40))
        && fotoOk(r);
    }
    // la riga nuova porta esattamente i totali della vecchia riga o, che nella stessa scrittura viene chiusa
    function migra(r) {
      let vecchia = get(/databases/$(database)/documents/arena/$(r.o)).data;
      return ('o' in r) && r.o != r.n.lower()
        && vecchia.n == r.n
        && !('t' in vecchia) && !('x' in vecchia)
        && getAfter(/databases/$(database)/documents/arena/$(r.o)).data.get('x', '') == r.n.lower()
        && r.m == vecchia.m && r.v == vecchia.v && r.b == vecchia.b;
    }

    // tutto il resto del database è chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
